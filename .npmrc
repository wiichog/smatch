# Igualar la resolución de dependencias entre local y el worker de EAS.
# Sin esto, EAS (resolución por defecto) intenta instalar peer-deps OPCIONALES
# (react-native-reanimated/worklets/gesture-handler, que @expo/ui jala vía expo-router)
# que no están en el package-lock.json → "npm ci out of sync" en la fase Install
# dependencies. La app no usa esas libs; con legacy-peer-deps el lock y EAS coinciden.
legacy-peer-deps=true
